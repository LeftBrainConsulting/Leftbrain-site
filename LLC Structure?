<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Molecular Logic — Entity Architecture</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
<style>
    :root {
        --black: #0f0f0f;
        --dark: #1c1c1c;
        --mid: #444;
        --border: #d8d8d4;
        --light: #f7f7f5;
        --accent: #1e4d35;
        --accent-light: #e8f0eb;
        --white: #fff;
        --serif: 'DM Serif Display', Georgia, serif;
        --sans: 'DM Sans', system-ui, sans-serif;
    }
    body { font-family: var(--sans); background: var(--light); color: var(--dark); display: flex; justify-content: center; padding: 60px 20px; line-height: 1.6; }
    .container { max-width: 700px; width: 100%; }

    /* PARENT ENTITY */
    .parent-card { 
        background: var(--white); 
        border: 1px solid var(--border); 
        padding: 40px; 
        text-align: center;
        margin-bottom: 40px;
        position: relative;
    }
    .parent-tag { font-size: 11px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: var(--mid); margin-bottom: 10px; display: block; }
    .parent-name { font-family: var(--serif); font-size: 2.2rem; margin: 0; color: var(--black); }

    /* CONNECTOR */
    .line { width: 2px; height: 40px; background: var(--border); margin: -40px auto 40px; }

    /* PRODUCT CARD */
    .product-card { 
        background: var(--white); 
        border: 2px solid var(--black); 
        padding: 48px; 
    }
    .product-name { font-family: var(--serif); font-size: 4.5rem; line-height: 1; margin: 0 0 10px 0; }
    .domain { font-weight: 500; color: var(--accent); font-size: 1.2rem; text-decoration: none; border-bottom: 1px solid var(--accent); padding-bottom: 2px; }
    
    .usp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 40px; text-align: left; }
    .usp-item { border-top: 1px solid var(--border); padding-top: 16px; }
    .usp-title { font-weight: 700; font-size: 13px; text-transform: uppercase; color: var(--black); }
    .usp-desc { font-size: 14px; color: var(--mid); margin-top: 4px; }

    .io-badge { 
        display: inline-block; 
        background: var(--accent-light); 
        color: var(--accent); 
        padding: 6px 12px; 
        font-size: 12px; 
        font-weight: 700; 
        border-radius: 4px; 
        margin-top: 30px; 
    }
</style>
</head>
<body>

<div class="container">
    <div class="parent-card">
        <span class="parent-tag">Founding Entity</span>
        <h2 class="parent-name">Molecular Logic LLC</h2>
    </div>

    <div class="line"></div>

    <div class="product-card">
        <h1 class="product-name">Blot</h1>
        <a href="https://getblot.io" class="domain">www.GetBlot.io</a>

        <div class="usp-grid">
            <div class="usp-item">
                <div class="usp-title">Compliance Layer</div>
                <div class="usp-desc">Locked-down protocols that prevent p-hacking and manual drift.</div>
            </div>
            <div class="usp-item">
                <div class="usp-title">Institutional SOP</div>
                <div class="usp-desc">The departmental standard for auditable Western Blot data.</div>
            </div>
        </div>

        <div class="io-badge">I/O: High-Fidelity Input / Auditable Output</div>
    </div>
</div>

</body>
</html>
